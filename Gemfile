# Only used for LOCAL preview (tools/serve.sh). GitHub Pages ignores this file
# and builds with its own pinned versions of Jekyll + plugins.
source "https://rubygems.org"
ruby "2.7.8"            # matches the ruby:2.7 Docker image; keeps Bundler from picking gems that need Ruby 3+
gem "github-pages", group: :jekyll_plugins
gem "webrick"          # needed by `jekyll serve` on Ruby 3+