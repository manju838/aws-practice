# Copy to config.env. It is same as .env file but named config.env assuming multiple envs.
# Instead of hardcoding all the secret variables, we source parts of it using bash so that the secret keys are not leaked.
# ACCOUNT_ID is looked up from your AWS credentials, so you can reference $ACCOUNT_ID below.

PROJECT=smartdocs                 # prefix for every resource name
AWS_REGION=ap-south-2

# ── resource names (derived; change only if you must) ────────────────
BUCKET=${PROJECT}-${ACCOUNT_ID}
ROLE_NAME=${PROJECT}-lambda-role
ROLE_ARN=arn:aws:iam::${ACCOUNT_ID}:role/${ROLE_NAME}
LAYER_NAME=${PROJECT}-faiss
INDEXER_FN=${PROJECT}-indexer
CHAT_FN=${PROJECT}-chat
TABLE_NAME=${PROJECT}-conversations
API_NAME=${PROJECT}-api

# ── models (Bedrock) ─────────────────────────────────────────────────
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
CHAT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
CHAT_TEMPERATURE=0.2              # leave empty if a newer model rejects the parameter
# scripts/10-check-bedrock.sh tries each of these and reports which your account can call.
# Confirm exact IDs with:  aws bedrock list-inference-profiles --query "inferenceProfileSummaries[?contains(inferenceProfileId,'anthropic')].inferenceProfileId"
CANDIDATE_MODELS="global.anthropic.claude-haiku-4-5-20251001-v1:0 global.anthropic.claude-sonnet-5 global.anthropic.claude-sonnet-4-5-20250929-v1:0"

# ── phase 5 ──────────────────────────────────────────────────────────
ALERT_EMAIL=                      # where CloudWatch alarms are emailed (you must confirm the SNS subscription)
