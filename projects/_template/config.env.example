# Copy to config.env (git-ignored) and adjust. Read by scripts/*.sh via tools/lib/common.sh.
# ACCOUNT_ID is looked up automatically, so you can reference $ACCOUNT_ID below.

PROJECT=__PROJECT__            # prefix for every resource name: __PROJECT__-<thing>
AWS_REGION=ap-south-2

# Derived names (change only if you need to)
BUCKET=${PROJECT}-${ACCOUNT_ID}
ROLE_NAME=${PROJECT}-lambda-role
